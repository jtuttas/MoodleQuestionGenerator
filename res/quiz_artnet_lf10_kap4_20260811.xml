<!-- Q12: multichoice (1P) – Sequence-Counter -->
<question type="multichoice">
  <name><text>ArtNet Sequence Counter Funktion</text></name>
  <questiontext format="html"><text><![CDATA[<p>Wofür wird der <strong>Sequence-Counter</strong> im ArtNet-DMX-Paket verwendet?</p>]]></text></questiontext>
  <defaultgrade>1</defaultgrade><penalty>0.3333333</penalty><hidden>0</hidden>
  <single>true</single><shuffleanswers>1</shuffleanswers>
  <correctfeedback format="html"><text><![CDATA[<p>Richtig!</p>]]></text></correctfeedback>
  <partiallycorrectfeedback format="html"><text></text></partiallycorrectfeedback>
  <incorrectfeedback format="html"><text><![CDATA[<p>Falsch. Der Sequence-Counter nummeriert Pakete, damit Out-of-Order-Pakete erkannt und verworfen werden.</p>]]></text></incorrectfeedback>
  <generalfeedback format="html"><text><![CDATA[<p>Der Sequence-Counter zählt von 1 bis 255 (dann Rollover). Empfänger erkennen damit veraltete oder außer-der-Reihe eingegangene Pakete und verwerfen sie.</p>]]></text></generalfeedback>
  <answer fraction="100" format="html"><text><![CDATA[Er nummeriert aufeinanderfolgende Pakete (1–255), damit der Empfänger Out-of-Order-Pakete erkennen und verwerfen kann]]></text><feedback format="html"><text><![CDATA[<p>Korrekt!</p>]]></text></feedback></answer>
  <answer fraction="-33.33333" format="html"><text><![CDATA[Er zählt die Gesamtanzahl der im Netzwerk aktiven Universen und aktualisiert diese bei jeder Sendung]]></text><feedback format="html"><text><![CDATA[<p>Falsch. Der Sequence-Counter hat nichts mit der Universum-Anzahl zu tun.</p>]]></text></feedback></answer>
  <answer fraction="-33.33333" format="html"><text><![CDATA[Er misst die Netzwerkverzögerung und hilft bei der automatischen Latenz-Optimierung des Netzwerks]]></text><feedback format="html"><text><![CDATA[<p>Falsch. Der Sequence-Counter ist kein Zeitstempel und misst keine Latenz.</p>]]></text></feedback></answer>
  <answer fraction="-33.33333" format="html"><text><![CDATA[Er gibt die Protokollversion des sendenden Geräts an und ermöglicht Abwärtskompatibilität]]></text><feedback format="html"><text><![CDATA[<p>Falsch. Die Protokollversion steht im Feld ProtVer, nicht im Sequence-Feld.</p>]]></text></feedback></answer>
</question>

