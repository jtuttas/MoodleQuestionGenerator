<!-- Q3: numerical (1P) – Universe-Globaladresse Net=1, Sub-Net=2, Uni=5 -->
<question type="numerical">
  <name><text>ArtNet Universum-Globaladresse 1</text></name>
  <questiontext format="html"><text><![CDATA[<p>Berechnen Sie die globale Universe-Adresse in ArtNet 4:</p><p style="text-align:center;font-family:monospace;background:#f0f9ff;padding:0.5rem;border-radius:4px;">Adresse = Net × 256 + Sub-Net × 16 + Universe</p><p><strong>Net = 1 &nbsp;|&nbsp; Sub-Net = 2 &nbsp;|&nbsp; Universe = 5</strong></p><p>Ergebnis:</p>]]></text></questiontext>
  <defaultgrade>1</defaultgrade><penalty>0</penalty><hidden>0</hidden>
  <generalfeedback format="html"><text><![CDATA[<p><strong>Lösung:</strong> 1 × 256 + 2 × 16 + 5 = 256 + 32 + 5 = <strong>293</strong></p>]]></text></generalfeedback>
  <answer fraction="100"><text>293</text><tolerance>0</tolerance></answer>
</question>

