<!-- Q17: ddmatch (4P) – ArtNet vs sACN Eigenschaften -->
<question type="ddmatch">
  <name><text>ArtNet sACN Eigenschaftszuordnung</text></name>
  <questiontext format="html"><text><![CDATA[<p>Ordnen Sie jede Eigenschaft dem korrekten Protokoll zu: <strong>ArtNet</strong> oder <strong>sACN (E1.31)</strong>.</p>]]></text></questiontext>
  <defaultgrade>4</defaultgrade><penalty>0</penalty><hidden>0</hidden><shuffleanswers>1</shuffleanswers>
  <correctfeedback format="html"><text><![CDATA[<p>Perfekt! ArtNet/sACN-Unterschiede korrekt zugeordnet.</p>]]></text></correctfeedback>
  <partiallycorrectfeedback format="html"><text><![CDATA[<p>Teilweise richtig.</p>]]></text></partiallycorrectfeedback>
  <incorrectfeedback format="html"><text><![CDATA[<p>Nicht korrekt. ArtNet: Artistic Licence, Broadcast, max. 32.768 Universen | sACN: ANSI E1.31, Multicast, max. 63.999.</p>]]></text></incorrectfeedback>
  <generalfeedback format="html"><text><![CDATA[<p>ArtNet: Hersteller-Standard von Artistic Licence, primär Broadcast, max. 32.768 Universen, sehr hohe Verbreitung bei Live-Events | sACN: ANSI/ESTA E1.31, Multicast, max. 63.999 Universen, bevorzugt bei Architektur/Studios</p>]]></text></generalfeedback>
  <subquestion format="html"><text><![CDATA[Hersteller-Standard von Artistic Licence (kein ANSI/ESTA-Standard)]]></text><answer><text>ArtNet</text></answer></subquestion>
  <subquestion format="html"><text><![CDATA[ANSI/ESTA E1.31 standardisiert]]></text><answer><text>sACN</text></answer></subquestion>
  <subquestion format="html"><text><![CDATA[Unterstützt maximal 32.768 Universen]]></text><answer><text>ArtNet</text></answer></subquestion>
  <subquestion format="html"><text><![CDATA[Nutzt Multicast für geringere Netzwerklast bei vielen Universen]]></text><answer><text>sACN</text></answer></subquestion>
</question>

<!-- Q18: numerical (1P) – Net=3, Sub-Net=0, Uni=15 → 783 -->
<question type="numerical">
  <name><text>ArtNet Universum-Globaladresse 3</text></name>
  <questiontext format="html"><text><![CDATA[<p>Berechnen Sie die globale Universe-Adresse nach: <code>Net × 256 + Sub-Net × 16 + Universe</code></p><p><strong>Net = 3 &nbsp;|&nbsp; Sub-Net = 0 &nbsp;|&nbsp; Universe = 15</strong></p>]]></text></questiontext>
  <defaultgrade>1</defaultgrade><penalty>0</penalty><hidden>0</hidden>
  <generalfeedback format="html"><text><![CDATA[<p><strong>Lösung:</strong> 3 × 256 + 0 × 16 + 15 = 768 + 0 + 15 = <strong>783</strong></p>]]></text></generalfeedback>
  <answer fraction="100"><text>783</text><tolerance>0</tolerance></answer>
</question>

