  <selectoption><text>8</text><group>3</group></selectoption>
  <selectoption><text>10</text><group>3</group></selectoption>
  <selectoption><text>16</text><group>3</group></selectoption>
  <selectoption><text>32</text><group>4</group></selectoption>
