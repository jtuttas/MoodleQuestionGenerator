# OpenAI-API-Schlüssel (nur für API-basierte Modelle / Iteration 2 benötigt)
# Nie committen – diese Datei als .env kopieren und befüllen
OPENAI_API_KEY=sk-...

# URL des lokalen Ollama-Dienstes
# Lokal: http://localhost:11434
# Docker: http://ollama:11434  (Servicename aus docker-compose.yml)
OLLAMA_URL=http://localhost:11434

# Datenbankdatei (SQLite, relativ zum Backend-Startverzeichnis)
# In Docker wird dieser Pfad auf ein Volume gemappt
DATABASE_URL=sqlite+aiosqlite:///./questions.db
