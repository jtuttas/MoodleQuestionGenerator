<?xml version="1.0" encoding="UTF-8"?>
<quiz>

<!-- ================================================================
     TEMPLATE: Alle Moodle-Fragetypen mit SVG-Diagramm
     Fragetypen: ddmatch | ddwtos | multichoice | cloze
     Inhalt ist absichtlich minimal gehalten – nur Struktur zählt.
     WICHTIG: Jedes <text>-Element mit HTML MUSS in CDATA stehen!
     ================================================================ -->


<!-- ==================== FRAGETYP 1: ddmatch ==================== -->
<!-- Zuordnungsaufgabe: Jede Zeile links wird einer Antwort rechts zugeordnet -->

  <question type="ddmatch">
    <name>
      <text>TEMPLATE ddmatch – Zuordnung mit SVG</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Ordnen Sie jedem nummerierten Element im Diagramm den richtigen Begriff zu:</p>
<svg xmlns="http://www.w3.org/2000/svg" width="300" height="120"
     style="font-family:Arial,sans-serif;font-size:13px;display:block;margin:10px auto;">
  <!-- Element ① -->
  <circle cx="150" cy="20" r="13" fill="#333"/>
  <text x="40" y="25" font-size="14" font-weight="bold" fill="#c00">①</text>
  <line x1="60" y1="22" x2="135" y2="20" stroke="#c00" stroke-width="1" stroke-dasharray="4,3"/>
  <!-- Element ② -->
  <rect x="75" y="50" width="150" height="30" rx="8" fill="#fff" stroke="#333" stroke-width="1.5"/>
  <text x="150" y="70" text-anchor="middle">Aktion</text>
  <text x="40" y="70" font-size="14" font-weight="bold" fill="#c00">②</text>
  <line x1="60" y1="68" x2="73" y2="65" stroke="#c00" stroke-width="1" stroke-dasharray="4,3"/>
</svg>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text>① ist ein Startknoten (ausgefüllter Kreis). ② ist eine Aktion (abgerundetes Rechteck).</text>
    </generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>0.1</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
    <shuffleanswers>true</shuffleanswers>
    <correctfeedback format="html">
      <text>Die Antwort ist richtig.</text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text>Die Antwort ist teilweise richtig.</text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text>Die Antwort ist falsch.</text>
    </incorrectfeedback>
    <shownumcorrect/>
    <!-- Jedes subquestion-Paar: linke Seite + zugehörige Antwort -->
    <subquestion format="html">
      <text><![CDATA[<p>① – ausgefüllter schwarzer Kreis</p>]]></text>
      <answer format="html">
        <text><![CDATA[<p>Startknoten</p>]]></text>
      </answer>
    </subquestion>
    <subquestion format="html">
      <text><![CDATA[<p>② – abgerundetes Rechteck</p>]]></text>
      <answer format="html">
        <text><![CDATA[<p>Aktion</p>]]></text>
      </answer>
    </subquestion>
    <!-- Distractor-Antwort (kein passendes subquestion – taucht als Falschoption auf) -->
    <subquestion format="html">
      <text><![CDATA[<p></p>]]></text>
      <answer format="html">
        <text><![CDATA[<p>Endknoten</p>]]></text>
      </answer>
    </subquestion>
  </question>


<!-- ==================== FRAGETYP 2: ddwtos ==================== -->
<!-- Drag-and-drop into text: Begriffe in Lücken [[1]] [[2]] [[3]] ziehen -->

  <question type="ddwtos">
    <name>
      <text>TEMPLATE ddwtos – Lückentext mit SVG</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Betrachten Sie das Klassendiagramm und ergänzen Sie die Lücken:</p>
<svg xmlns="http://www.w3.org/2000/svg" width="280" height="110"
     style="font-family:Arial,sans-serif;font-size:13px;display:block;margin:10px auto;">
  <!-- Klassename -->
  <rect x="65" y="10" width="150" height="28" fill="#dce8fc" stroke="#333" stroke-width="1.5"/>
  <text x="140" y="29" text-anchor="middle" font-weight="bold">Beispiel</text>
  <!-- Attribute -->
  <rect x="65" y="38" width="150" height="44" fill="#fff" stroke="#333" stroke-width="1.5"/>
  <text x="73" y="56" font-size="12">+ name: string</text>
  <text x="73" y="74" font-size="12">- __id: int</text>
  <!-- Methode -->
  <rect x="65" y="82" width="150" height="22" fill="#fff" stroke="#333" stroke-width="1.5"/>
  <text x="73" y="98" font-size="12">+ tuEtwas(): void</text>
</svg>
<p>Das Attribut <code>name</code> hat die Sichtbarkeit [[1]].</p>
<p>Das Attribut <code>__id</code> hat die Sichtbarkeit [[2]].</p>
<p>Die Methode <code>tuEtwas()</code> gibt [[3]] zurück.</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text>+ = public, - = private. void bedeutet kein Rückgabewert.</text>
    </generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>0.25</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
    <shuffleanswers>1</shuffleanswers>
    <correctfeedback format="html">
      <text>Die Antwort ist richtig.</text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text>Die Antwort ist teilweise richtig.</text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text>Die Antwort ist falsch.</text>
    </incorrectfeedback>
    <shownumcorrect/>
    <!-- group-Nummer muss zur Lückennummer [[n]] passen -->
    <dragbox><text>public</text><group>1</group></dragbox>
    <dragbox><text>protected</text><group>1</group></dragbox>    <!-- Distractor für Lücke 1 -->
    <dragbox><text>private</text><group>2</group></dragbox>
    <dragbox><text>static</text><group>2</group></dragbox>       <!-- Distractor für Lücke 2 -->
    <dragbox><text>void</text><group>3</group></dragbox>
    <dragbox><text>int</text><group>3</group></dragbox>          <!-- Distractor für Lücke 3 -->
  </question>


<!-- ==================== FRAGETYP 3: multichoice ==================== -->
<!-- Mehrfachauswahl: fraction summiert sich bei richtigen zu ~100%, negativ bei falschen -->

  <question type="multichoice">
    <name>
      <text>TEMPLATE multichoice – Mehrfachauswahl mit SVG</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Betrachten Sie das Diagramm. Welche Aussagen sind korrekt?</p>
<svg xmlns="http://www.w3.org/2000/svg" width="300" height="130"
     style="font-family:Arial,sans-serif;font-size:13px;display:block;margin:10px auto;">
  <defs>
    <marker id="ah" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
      <polygon points="0 0,8 3,0 6" fill="#333"/>
    </marker>
  </defs>
  <!-- Systemgrenze -->
  <rect x="80" y="10" width="200" height="110" rx="4" fill="#f9f9f9" stroke="#333" stroke-width="2"/>
  <text x="180" y="27" text-anchor="middle" font-size="11" font-weight="bold">System</text>
  <!-- UseCase -->
  <ellipse cx="180" cy="75" rx="80" ry="25" fill="#fff" stroke="#333" stroke-width="1.5"/>
  <text x="180" y="79" text-anchor="middle">Funktion A</text>
  <!-- Akteur -->
  <circle cx="35" cy="50" r="11" fill="#fff" stroke="#333" stroke-width="1.5"/>
  <line x1="35" y1="61" x2="35" y2="90" stroke="#333" stroke-width="1.5"/>
  <line x1="18" y1="73" x2="52" y2="73" stroke="#333" stroke-width="1.5"/>
  <line x1="35" y1="90" x2="20" y2="112" stroke="#333" stroke-width="1.5"/>
  <line x1="35" y1="90" x2="50" y2="112" stroke="#333" stroke-width="1.5"/>
  <text x="35" y="125" text-anchor="middle" font-size="11">Nutzer</text>
  <line x1="46" y1="65" x2="100" y2="70" stroke="#333" stroke-width="1.5"/>
</svg>
<p>Welche Aussagen über das Diagramm sind korrekt?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text>Akteure stehen außerhalb der Systemgrenze. UseCases stehen innerhalb. Das Rechteck stellt die Systemgrenze dar.</text>
    </generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>0.1</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
    <single>false</single>             <!-- false = Mehrfachauswahl, true = Einzelauswahl -->
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>none</answernumbering>
    <showstandardinstruction>1</showstandardinstruction>
    <correctfeedback format="html">
      <text>Korrekt!</text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text>Teilweise richtig.</text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text>Falsch.</text>
    </incorrectfeedback>
    <!-- Richtige Antworten: fraction addiert sich zu 100% (hier 2x 50%) -->
    <answer fraction="50" format="html">
      <text><![CDATA[<p>„Nutzer" ist ein Akteur außerhalb der Systemgrenze</p>]]></text>
      <feedback format="html">
        <text>Richtig! Akteure stehen immer außerhalb der Systemgrenze.</text>
      </feedback>
    </answer>
    <answer fraction="50" format="html">
      <text><![CDATA[<p>„Funktion A" ist ein UseCase innerhalb der Systemgrenze</p>]]></text>
      <feedback format="html">
        <text>Richtig! UseCases (Ellipsen) stehen immer innerhalb der Systemgrenze.</text>
      </feedback>
    </answer>
    <!-- Falsche Antworten: negative fraction als Strafpunkte -->
    <answer fraction="-50" format="html">
      <text><![CDATA[<p>„Nutzer" ist ein UseCase und wird als Ellipse dargestellt</p>]]></text>
      <feedback format="html">
        <text>Falsch. „Nutzer" ist ein Akteur (Strichmännchen), kein UseCase.</text>
      </feedback>
    </answer>
    <answer fraction="-50" format="html">
      <text><![CDATA[<p>UseCases können sich außerhalb der Systemgrenze befinden</p>]]></text>
      <feedback format="html">
        <text>Falsch. UseCases befinden sich immer innerhalb der Systemgrenze.</text>
      </feedback>
    </answer>
  </question>


<!-- ==================== FRAGETYP 4: cloze ==================== -->
<!-- Eingebettete Fragen: MULTICHOICE direkt im Fragetext via {n:TYP:...} -->

  <question type="cloze">
    <name>
      <text>TEMPLATE cloze – Eingebetteter Lückentext mit SVG</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Analysieren Sie das Diagramm und beantworten Sie die Fragen:</p>
<svg xmlns="http://www.w3.org/2000/svg" width="300" height="150"
     style="font-family:Arial,sans-serif;font-size:13px;display:block;margin:10px auto;">
  <defs>
    <marker id="ahC" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
      <polygon points="0 0,8 3,0 6" fill="#333"/>
    </marker>
  </defs>
  <!-- Startknoten -->
  <circle cx="150" cy="20" r="13" fill="#333"/>
  <line x1="150" y1="33" x2="150" y2="55" stroke="#333" stroke-width="1.5" marker-end="url(#ahC)"/>
  <!-- Aktion -->
  <rect x="75" y="58" width="150" height="30" rx="8" fill="#fff" stroke="#333" stroke-width="1.5"/>
  <text x="150" y="78" text-anchor="middle">Schritt 1</text>
  <line x1="150" y1="88" x2="150" y2="110" stroke="#333" stroke-width="1.5" marker-end="url(#ahC)"/>
  <!-- Endknoten -->
  <circle cx="150" cy="123" r="13" fill="#fff" stroke="#333" stroke-width="1.5"/>
  <circle cx="150" cy="123" r="8"  fill="#333"/>
</svg>

<p>1. Womit beginnt das Diagramm?
{1:MULTICHOICE:Einer Raute~=Einem ausgefüllten Kreis~Einem Rechteck~Einem Balken}</p>

<p>2. Was stellt das abgerundete Rechteck dar?
{1:MULTICHOICE:=Eine Aktion~Einen Startknoten~Einen Endknoten~Eine Entscheidung}</p>

<p>3. Womit endet das Diagramm?
{1:MULTICHOICE:Einer Raute~Einem ausgefüllten Kreis~=Einem Kreis-im-Kreis (◉)~Einem Balken}</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text>Startknoten = ausgefüllter schwarzer Kreis. Aktion = abgerundetes Rechteck. Endknoten = Kreis mit kleinem ausgefüllten Kreis (◉).</text>
    </generalfeedback>
    <!-- Kein defaultgrade bei cloze – Punkte werden aus den eingebetteten Fragen berechnet -->
    <penalty>0.1</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
  </question>


</quiz>
